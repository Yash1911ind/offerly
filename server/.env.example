PORT=5000
# Local MongoDB (default) - replace with your Atlas connection string for deployment
MONGO_URI=mongodb://127.0.0.1:27017/placement_tracker
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Optional: anyone registering with this code becomes a placement-cell admin
ADMIN_CODE=PLACEMENT2026
# Comma-separated origins allowed by CORS in production (dev uses the Vite proxy)
CLIENT_ORIGIN=http://localhost:5173
